# Database connection for API
# Option A: discrete PG* variables
PGHOST=watchtracker_postgres
PGPORT=5432
PGDATABASE=WatchTracker
PGUSER=postgres
PGPASSWORD=change-me

# Option B: full DSN (if set, API can use it instead of PG*)
# DATABASE_URL=postgresql://postgres:change-me@watchtracker_postgres:5432/WatchTracker

# API runtime
RUN_MIGRATIONS=false
AUTH_TOKEN_TTL_HOURS=720
AUTH_TOKEN_CLEANUP_INTERVAL_SECONDS=3600
AUTH_ALERT_WINDOW_SECONDS=300
AUTH_ALERT_FAILURE_THRESHOLD=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_FREE_ATTEMPTS=3
AUTH_RATE_LIMIT_BASE_DELAY_SECONDS=3
AUTH_RATE_LIMIT_MAX_DELAY_SECONDS=300
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_HISTORY_LIMIT=5
AUTH_TOKEN_PURGE_RETENTION_DAYS=30
EMAIL_VERIFICATION_PURGE_RETENTION_DAYS=7
PASSWORD_RESET_PURGE_RETENTION_DAYS=7
EMAIL_DELIVERY_LOG_RETENTION_DAYS=30
# Optional daily cap for outbound emails (empty = no cap)
# EMAIL_DAILY_SEND_LIMIT=300
# Optional absolute base URL used in password reset emails (defaults to request base URL)
# RESET_PASSWORD_LINK_BASE_URL=https://api.watchtracker.app

# Optional bootstrap admin account (created once if not exists, already email-verified)
# ADMIN_BOOTSTRAP_EMAIL=admin@watchtracker.net
# ADMIN_BOOTSTRAP_PASSWORD=change-me-strong

# Optional admin 2FA (TOTP). If ADMIN_2FA_EMAIL is set, 2FA applies to that email.
# If ADMIN_2FA_EMAIL is empty, fallback is ADMIN_BOOTSTRAP_EMAIL, then admin@watchtracker.com.
# With a target email + secret, login requires a 6-digit code from an authenticator app.
# ADMIN_2FA_EMAIL=admin@watchtracker.com
# Example secret format: base32 (Google Authenticator compatible)
# ADMIN_2FA_TOTP_SECRET=JBSWY3DPEHPK3PXP
# Optional tuning:
# ADMIN_2FA_TOTP_WINDOW_STEPS=1
# ADMIN_2FA_TOTP_PERIOD_SECONDS=30
# ADMIN_2FA_TOTP_DIGITS=6
