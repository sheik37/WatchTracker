# Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Brevo (email verification)
BREVO_API_KEY=xkeysib-your-brevo-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=WatchTracker

# Cloudflare DDNS (api.watchtracker.net)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_DNS_RECORD_NAME=api.watchtracker.net
CLOUDFLARE_DNS_PROXIED=true
# CLOUDFLARE_DNS_TTL=1

# Noms de conteneurs (optionnel, les scripts common/*.sh utilisent ces
# valeurs par defaut si les variables ne sont pas definies ici)
# API_CONTAINER_NAME=watchtracker_api-api-1
# POSTGRES_CONTAINER_NAME=watchtracker_postgres
