# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=WatchTracker
POSTGRES_HOST_PORT=5433

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_HOST_PORT=8085
PGADMIN_BIND_ADDRESS=127.0.0.1

# Scripts / ops
POSTGRES_CONTAINER_NAME=watchtracker_postgres
API_CONTAINER_NAME=watchtracker_api-api-1
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
RESTORE_TEST_DB=watchtracker_restore_test
RESTORE_DROP_AFTER_TEST=true
STOP_API_DURING_RESTORE=true
BACKUP_BEFORE_RESTORE=true
RESTORE_NOTIFY_ON_SUCCESS=true
RUN_RESTORE_TEST_ON_WEEKDAY=7
RUN_WEEKLY_AUDIT_ON_WEEKDAY=7
LOG_RETENTION_DAYS=30
WATCHTRACKER_LOG_DIR=../logs
HYPERBACKUP_TASK_ID=

